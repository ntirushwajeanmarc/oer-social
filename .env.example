# Root Compose env (auto-loaded by docker compose). Copy to `.env`.
# Never commit the real `.env`.

# --- Cloudflare Tunnel (PRODUCTION VPS ONLY) ---
# Use ONE connector for a tunnel token. If laptop + VPS both run it,
# Cloudflare load-balances and you get intermittent 502 Bad Gateway.
#
# On the VPS:
#   COMPOSE_PROFILES=tunnel
#   CLOUDFLARE_TUNNEL_TOKEN=<token from Zero Trust → Tunnels → Configure>
#
# On a laptop / local dev: leave BOTH empty (or omit them).
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
