# Copy to .env — never commit .env
DATABASE_URL=

# CircuitNotion AI API (OpenAI SDK compatible)
# Docs: https://circuitnotion.com/Api_Documentation
OPENAI_BASE_URL=https://api.circuitnotion.com/v1
CIRCUITNOTION_API_KEY=
# Kept for compatibility; CIRCUITNOTION_API_KEY is preferred
OPENAI_API_KEY=
# Chat models: circuit-2-turbo | circuit-3 | deepseek-v4-pro | gpt-4.1 | gpt-4o-mini
OPENAI_MODEL=circuit-2-turbo
# Image generation via CircuitNotion images.generate
# dall-e-2 is NOT cheap here — CircuitNotion routes it to gpt-image-2 at default
# (often high) quality. Use gpt-image-2 + low:
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1024
# Embeddings for admin memory retrieval (pgvector)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536
MEMORY_EMBED_ENABLED=true

CORS_ORIGINS=http://localhost:3000
# When using Cloudflare Tunnel, add your public URL:
# CORS_ORIGINS=http://localhost:3000,https://oer.yourdomain.com
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=OER Admin
BOOTSTRAP_ADMIN_SYNC=true
PUBLIC_BASE_URL=http://localhost:8000
# With Cloudflare Tunnel (single hostname on port 3000):
# PUBLIC_BASE_URL=https://oer.yourdomain.com
MEDIA_DIR=/app/media

# X / Twitter OAuth 1.0a user tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram Business + Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Cloudflare Tunnel (docker compose service: cloudflared)
# Also put the same value in oer-social/.env so Compose can inject TUNNEL_TOKEN
CLOUDFLARE_TUNNEL_TOKEN=
# In Zero Trust → Public Hostname → Service URL must be: http://web:3000
